# Required to read public Imgur API resources.
IMGUR_CLIENT_ID=

# Required for command history and command replies. Also required when automatic
# repost comments are enabled. DRY_RUN only suppresses automatic repost comments.
IMGUR_ACCESS_TOKEN=

# Optional. If supplied with IMGUR_CLIENT_SECRET, the bot can refresh its access token.
IMGUR_CLIENT_SECRET=
IMGUR_REFRESH_TOKEN=

# Safety default: do not post automatic repost-statistics comments until explicitly disabled.
# Explicit @bot commands such as blockme/help can still receive replies.
DRY_RUN=true

DATABASE_PATH=repoststats.sqlite3
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300
GALLERY_SECTIONS=user,hot
GALLERY_SORT=viral
GALLERY_WINDOW=day
GALLERY_PAGES=4
# Backfill self-terminates a section after this many consecutive pages with no
# newly-indexed posts, so a deep backfill quits once content is exhausted instead
# of grinding through thousands of empty/already-seen pages. 0 disables. Only
# affects `backfill`, not the live scan; override per run with --stop-after-stale.
BACKFILL_STOP_AFTER_STALE_PAGES=50
MIN_NET_SCORE=40
# Only comment on posts newer than this many seconds (43200 = 12 hours).
MAX_POST_AGE_SECONDS=43200
COMMENT_COOLDOWN_SECONDS=40

# Original project-style near-duplicate thresholds.
AHASH_MAX_DISTANCE=3
DHASH_H_MAX_DISTANCE=10
DHASH_V_MAX_DISTANCE=10
BITCOUNT_PADDING=22

# If true, ignore reposts by the same account as the prior post.
IGNORE_SAME_ACCOUNT=true

# Self-service command handling. Requires IMGUR_ACCESS_TOKEN because mention
# history is account-specific and confirmation replies are authenticated.
BOT_USERNAME=RepostStatisticsRedux
COMMANDS_ENABLED=true
COMMAND_POLL_INTERVAL_SECONDS=60
# Ignore blockme/help mentions older than this many days. Wider is safer for a
# privacy opt-out: it still gets honored if the bot was down for a while.
COMMAND_MAX_AGE_DAYS=7
BLOCKME_REPLY=Done. I won't post repost-statistics comments on your posts anymore.
BLOCKME_ALREADY_BLOCKED_REPLY=You're already blocked from my repost-statistics comments.

# LAN-only administration web app. WEB_HOST=0.0.0.0 listens on all interfaces;
# restrict access with your host/router firewall and do not port-forward it.
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_JOB_LOG_DIR=logs/jobs

# Shared file log used by the bot and shown in the web console.
LOG_FILE=logs/repostbot.log

# Days to keep rotated/compressed log archives before deleting them. The live
# bot rotates the main log on each day rollover; `python app.py rotate-logs`
# does the same on demand (handy from cron if the bot isn't always running).
LOG_RETENTION_DAYS=14

# --- Weekly repost-statistics recap post ---
# When enabled, the live bot publishes a weekly recap to the Imgur gallery: one
# meme template (from WEEKLY_TEMPLATE_DIR) plus the week's stats in the title and
# description. Templates rotate least-recently-used, so 52 of them cover a year
# with no repeats. Preview any time with: python app.py post-weekly --dry-run
WEEKLY_POST_ENABLED=false
# Day and 24h local time to post. WEEKLY_POST_DAY is a full weekday name.
WEEKLY_POST_DAY=friday
WEEKLY_POST_TIME=13:00
# Folder of meme templates (images). Files with "example" in the name are ignored.
WEEKLY_TEMPLATE_DIR=template
# Optional comma-separated gallery tags for the weekly post.
WEEKLY_POST_TAGS=
